# The Free Stack — environment configuration
# Copy to .env (or set these in GitHub repo secrets for the Actions loop).
# EVERYTHING is optional: with zero variables set, the engine still researches
# (via free keyless endpoints), writes (template backend), builds the site and
# serves RSS. Each variable below unlocks one more free capability.

# --- where the site is published (used for canonical/sitemap/OG tags) ---
SITE_URL=https://abhishekghosh19.github.io/Abhishek-s-Repository-/autopilot-blog/site

# --- free-tier LLM writing (any OpenAI-compatible endpoint) ---
# Google Gemini free tier example:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=your-gemini-key
#   LLM_MODEL=gemini-1.5-flash
# Groq free tier example:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=your-groq-key
#   LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter free models example:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=your-openrouter-key
#   LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Local Ollama (free forever) example:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- free social channels (unconfigured ones are skipped, never fatal) ---
# Discord: any server -> server settings -> integrations -> webhooks
DISCORD_WEBHOOK_URL=
# Telegram: message @BotFather /newbot, then the chat id of where to post
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mastodon: any instance -> developer settings -> new app -> access token
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=
# Bluesky: account settings -> apps and passwords -> create app password
BSKY_HANDLE=
BSKY_APP_PASSWORD=
